# lintasJB NMS — contoh konfigurasi
# Salin file ini menjadi .env lalu sesuaikan.

# Port HTTP aplikasi
PORT=8787

# Lokasi database JSON, upload, dan secrets
# DATA_DIR=./data

# Secret token login (JWT). Kosongkan agar dibuat otomatis di data/secrets.json.
# JWT_SECRET=ganti-dengan-string-acak-panjang

# Secret HMAC lisensi. Kosongkan agar dibuat otomatis.
# LICENSE_SECRET=ganti-dengan-string-acak-panjang

# Kunci enkripsi kredensial integrasi (AES-256-GCM). Kosongkan agar otomatis.
# ENCRYPTION_KEY=ganti-dengan-string-acak-panjang

# Wajibkan token pada webhook GenieACS (1 = ya, 0 = tidak)
WEBHOOK_STRICT=0
